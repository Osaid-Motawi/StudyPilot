BACKEND_PORT=8080
# Local dev: path to a service account key file (see serviceAccount.json).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Production (e.g. Render): paste the full service account JSON as a single
# line. When set, this takes precedence over GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=studypilot-osaid
AGENT_BASE_URL=http://localhost:8001
